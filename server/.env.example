# Port the API listens on
PORT=4000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://sweety:sweety@localhost:5432/sweety

# Secret used to sign login tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts (optional, default 7d)
JWT_EXPIRES_IN=7d

# URL the React app runs on, allowed by CORS (optional, default http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
